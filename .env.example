# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GMAIL SMTP: Used to send real verification emails to users from readoracontact@gmail.com
# Generate a 16-character App Password at https://myaccount.google.com/apppasswords
GMAIL_USER="readoracontact@gmail.com"
GMAIL_APP_PASSWORD="your_16_digit_app_password"

# SUPABASE (Frontend): Public project URL and Anon Key only.
# Never expose SUPABASE_SERVICE_ROLE_KEY or RESEND_API_KEY with VITE_ prefix.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your_supabase_anon_key"

# SUPABASE (Server-only - Netlify Functions / Express server.ts):
# Keep secret! Never add VITE_ prefix and never commit real values.
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# Optional server-only HMAC secret for OTP cooldown cookies (falls back to SUPABASE_SERVICE_ROLE_KEY if unset)
OTP_COOKIE_SECRET="your_random_otp_cookie_secret"
